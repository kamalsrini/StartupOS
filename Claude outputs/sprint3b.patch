+    conn.commit()
+    _connect(TB, "slack", None)  # the connections row…
+    with tenant_conn(TB, APP_TEST_DSN) as c:  # …pointing at B's own encrypted bot token
+        secrets.put(c, TB, "slack_api_key", "xoxb-beta")
+
+    posted: list[dict] = []
