+def press(payload_action, *, team=TEAM_A, user=USER_A_SLACK, value="ap-1"):
+    return {
+        "type": "block_actions",
+        "team": {"id": team},
+        "user": {"id": user},
+        "actions": [{"action_id": payload_action, "value": value, "type": "button"}],
+    }
