+    "bot_token": "xoxb-e2e-alpha-token",
+    "channel": "#alpha-ops",
+    "dm": "D-ALPHA",
+    "linear_key": "lin_api_e2e_alpha",
+}
+B = {
+    "name": "E2E Beta",
+    "tenant": "e2e-beta",
+    "email": "founder@e2e-beta.test",
+    "team": "T-E2E-BETA",
+    "team_name": "Beta Workspace",
+    "slack_user": "U-E2E-BETA",
+    "bot_token": "xoxb-e2e-beta-token",
+    "channel": "#beta-ops",
