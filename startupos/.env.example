# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres@localhost:5432/startupos          # superuser: migrations only
STARTUPOS_APP_DSN=postgresql://startupos_app:startupos_app@localhost:5432/startupos   # RLS-bound role: services
STARTUPOS_APP_PASSWORD=startupos_app             # docker compose sets the role password from this at migrate; change it
STARTUPOS_TEST_DSN=postgresql://postgres@localhost:5432/startupos_test
TENANT_ID=unitone

# Auth — generate STARTUPOS_SESSION_SECRET with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STARTUPOS_SESSION_SECRET=
STARTUPOS_SESSION_TTL_HOURS=336
STARTUPOS_PUBLIC_URL=http://localhost:8000       # API origin (Google redirect URI = $STARTUPOS_PUBLIC_URL/auth/google/callback)
STARTUPOS_WEB_URL=http://localhost:3000          # where to send the browser after login
# Google Cloud → APIs & Services → Credentials → OAuth client (Web). Full runbook: docs/GOOGLE-SIGNIN.md
#   Authorised redirect URI  = $STARTUPOS_PUBLIC_URL/auth/google/callback   (https://<domain>/api/... in prod)
#   Authorised JS origin     = $STARTUPOS_WEB_URL
# A consent screen left in "Testing" admits ONLY the accounts listed as test users — publish it, or nobody you
# share the URL with can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One-time owner login before Google is configured: POST /auth/bootstrap. Leave EMPTY unless you are using it —
# any non-empty value enables that endpoint. (Keep the comment on its own line: docker compose's .env parser
# treats `KEY=   # note` on an EMPTY value as the value, which would switch bootstrap on with a public token.)
STARTUPOS_BOOTSTRAP_TOKEN=

# Public hosting (Sprint 3d) — full runbook: docs/HOSTING.md
# Leave STARTUPOS_DOMAIN empty for a private deploy: `docker compose up` then behaves exactly as before and
# nothing is published. Filling it in turns on the `public` profile (web + caddy) in scripts/deploy_azure.sh.
# When you set it, these SIX move together — deploy_azure.sh refuses to deploy if they disagree:
#   STARTUPOS_DOMAIN=os.example.com
#   STARTUPOS_ACME_EMAIL=you@example.com
#   STARTUPOS_PATH_PREFIX=/api
#   STARTUPOS_PUBLIC_URL=https://os.example.com/api     (note the /api)
#   STARTUPOS_WEB_URL=https://os.example.com
#   STARTUPOS_COOKIE_SECURE=1
# STARTUPOS_DOMAIN: e.g. startupos-unitone.eastus.cloudapp.azure.com
STARTUPOS_DOMAIN=
# STARTUPOS_ACME_EMAIL: where Let's Encrypt sends expiry notices
STARTUPOS_ACME_EMAIL=
# STARTUPOS_PATH_PREFIX: empty locally; /api behind the public proxy
STARTUPOS_PATH_PREFIX=
STARTUPOS_COOKIE_SECURE=1                        # 1 in production (HTTPS only); the API relaxes it for localhost

# Self-serve sign-up (Sprint 3d PE review). Sharing the public URL means a stranger who signs in with Google
# gets a company of their own, and the daemon then spends Tier-2 tokens for it. These two are the cap and the
# off switch; both are read per request, so changing them needs a restart of the api service, not a rebuild.
# 1 (default) = anyone with the URL can create their own company; 0 = closed (POST /onboarding/tenant refuses
# with copy, the Google callback says so instead of dead-ending, and the sign-in page says new companies are
# closed). Existing people keep signing in either way, and the operator keeps creating companies with
# STARTUPOS_BOOTSTRAP_TOKEN.
STARTUPOS_ALLOW_SIGNUP=1
# Monthly Tier-2 token allowance for a company created that way (tenants.tier = 'self_serve'). An
# operator-created company is unchanged on the founder tier (1.5M). Promote a real customer with
# `UPDATE tenants SET tier = 'founder' WHERE id = '<slug>';` — the tier is the only thing that sets the budget.
STARTUPOS_SIGNUP_TIER2_TOKENS=100000
# Interactive API docs (/docs, /redoc, /openapi.json). Off automatically whenever this deployment is public
# (STARTUPOS_DOMAIN or STARTUPOS_PATH_PREFIX set), on locally. Set 1 to force them on (debugging a deploy —
# they expose every route and schema to anyone with the URL), 0 to force them off everywhere.
STARTUPOS_ENABLE_DOCS=

# Per-tenant secrets (connections' API keys) are envelope-encrypted in Postgres under this master key.
# 32 random bytes, urlsafe base64. Generate with:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing it loses every stored credential; rotate with common.secrets.rotate_master. Never commit it.
STARTUPOS_MASTER_KEY=

# Daemon (Tier 1/2 model calls). Ingest and signals never use this.
ANTHROPIC_API_KEY=
STARTUPOS_TIER2_MODEL=claude-sonnet-4-5
STARTUPOS_TIER1_MODEL=claude-haiku-4-5

# Linear — Settings → API → Personal API keys
LINEAR_API_KEY=

# Slack app (Sprint 3b) — full operator runbook: ../docs/SLACK-SETUP.md
# ONE app serves the whole install; each tenant installs it into its own workspace and
# its bot token is stored per tenant, encrypted (never an env var). api.slack.com/apps → your app:
#   Basic Information → App Credentials   → Client ID, Client Secret, Signing Secret
#   OAuth & Permissions → Redirect URLs   → $STARTUPOS_PUBLIC_URL/slack/oauth/callback
#   Event Subscriptions → Request URL     → $STARTUPOS_PUBLIC_URL/slack/events   (app_mention, message.im,
#                                           app_uninstalled, tokens_revoked)
#   Interactivity & Shortcuts → Request URL → $STARTUPOS_PUBLIC_URL/slack/interactivity
# Unset → GET /slack/install and the inbound Slack routes answer 503; nothing else degrades.
STARTUPOS_SLACK_CLIENT_ID=
STARTUPOS_SLACK_CLIENT_SECRET=
STARTUPOS_SLACK_SIGNING_SECRET=

# Slack — bot token (xoxb-…) with channels:history, channels:read, chat:write
SLACK_BOT_TOKEN=
SLACK_CHANNELS=
SLACK_DIGEST_CHANNEL=

# Brex — Developer → API tokens, READ-ONLY scopes only
BREX_API_TOKEN=

# Optional
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_rTpjbAHqJufb8oQPlY2yfUMQ
