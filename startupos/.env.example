# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres@localhost:5432/startupos          # superuser: migrations only
STARTUPOS_APP_DSN=postgresql://startupos_app:startupos_app@localhost:5432/startupos   # RLS-bound role: services
STARTUPOS_APP_PASSWORD=startupos_app             # docker compose sets the role password from this at migrate; change it
STARTUPOS_TEST_DSN=postgresql://postgres@localhost:5432/startupos_test
TENANT_ID=unitone

# Auth — generate STARTUPOS_SESSION_SECRET with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STARTUPOS_SESSION_SECRET=
STARTUPOS_SESSION_TTL_HOURS=336
STARTUPOS_PUBLIC_URL=http://localhost:8000       # API origin (Google redirect URI = $STARTUPOS_PUBLIC_URL/auth/google/callback)
STARTUPOS_WEB_URL=http://localhost:3000          # where to send the browser after login
GOOGLE_CLIENT_ID=                                # Google Cloud → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_SECRET=
STARTUPOS_BOOTSTRAP_TOKEN=                       # one-time owner login before Google is configured: POST /auth/bootstrap

# Per-tenant secrets (connections' API keys) are envelope-encrypted in Postgres under this master key.
# 32 random bytes, urlsafe base64. Generate with:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing it loses every stored credential; rotate with common.secrets.rotate_master. Never commit it.
STARTUPOS_MASTER_KEY=

# Daemon (Tier 1/2 model calls). Ingest and signals never use this.
ANTHROPIC_API_KEY=
STARTUPOS_TIER2_MODEL=claude-sonnet-4-5
STARTUPOS_TIER1_MODEL=claude-haiku-4-5

# Linear — Settings → API → Personal API keys
LINEAR_API_KEY=

# Slack app (Sprint 3b) — full operator runbook: ../docs/SLACK-SETUP.md
# ONE app serves the whole install; each tenant installs it into its own workspace and
# its bot token is stored per tenant, encrypted (never an env var). api.slack.com/apps → your app:
#   Basic Information → App Credentials   → Client ID, Client Secret, Signing Secret
#   OAuth & Permissions → Redirect URLs   → $STARTUPOS_PUBLIC_URL/slack/oauth/callback
#   Event Subscriptions → Request URL     → $STARTUPOS_PUBLIC_URL/slack/events   (app_mention, message.im,
#                                           app_uninstalled, tokens_revoked)
#   Interactivity & Shortcuts → Request URL → $STARTUPOS_PUBLIC_URL/slack/interactivity
# Unset → GET /slack/install and the inbound Slack routes answer 503; nothing else degrades.
STARTUPOS_SLACK_CLIENT_ID=
STARTUPOS_SLACK_CLIENT_SECRET=
STARTUPOS_SLACK_SIGNING_SECRET=

# Slack — bot token (xoxb-…) with channels:history, channels:read, chat:write
SLACK_BOT_TOKEN=
SLACK_CHANNELS=
SLACK_DIGEST_CHANNEL=

# Brex — Developer → API tokens, READ-ONLY scopes only
BREX_API_TOKEN=

# Optional
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_rTpjbAHqJufb8oQPlY2yfUMQ
